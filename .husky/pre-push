echo "🔍 Checking for uncommented eruda imports..."
if grep -r "import.*eruda" src/ --include="*.ts" --include="*.tsx" --include="*.js" --include="*.jsx" | grep -v ":.*[[:space:]]*//.*import.*eruda"; then
  echo "❌ Found uncommented eruda imports in the codebase!"
  echo "Please comment out or remove eruda imports before pushing."
  exit 1
else
  echo "✅ No uncommented eruda imports found."
fi

echo "🔍 Checking for local dependency paths..."
pnpm exec node --input-type=module <<'NODE' || exit 1
import { readFileSync } from "node:fs"

const localReference = /:[ \t]+["']?(?:(?:file|link):|[\\/]|~[\\/]|\.{1,2}[\\/]|[A-Za-z]:[\\/])/
const matches = readFileSync("pnpm-lock.yaml", "utf8")
  .split("\n")
  .flatMap((line, index) => localReference.test(line) ? [String(index + 1) + ":" + line] : [])

if (matches.length > 0) {
  console.error("❌ Found local dependency paths in pnpm-lock.yaml:\n" + matches.join("\n"))
  console.error("Replace local links with published versions, then run pnpm install.")
  process.exit(1)
}

console.log("✅ No local dependency paths found.")
NODE

pnpm exec nx lint
pnpm exec nx type-check
# pnpm exec nx build

# Check if SKIP_FREE_API environment variable is set
if [ "$SKIP_FREE_API" = "true" ]; then
  pnpm exec nx test -- --exclude="**/free-api.test.ts"
else
  pnpm exec nx test
fi
